# WxPusher 推送配置（必填）
# 在 https://wxpusher.zjiecode.com/admin/main/app/appToken 创建应用获取
WXPUSHER_APP_TOKEN=AT_xxxxxxxxxxxxxxxxxxxxxxxxx
# 在 https://wxpusher.zjiecode.com 扫码关注后获取 UID（多个用逗号分隔）
WXPUSHER_UIDS=UID_xxxxxxxxxxxxxxxxxxxxxxxx

# AI 摘要配置（可选，留空则跳过摘要）
# 推荐 DeepSeek：https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 调试开关：true 表示不真正推送，仅打印
DRY_RUN=false
